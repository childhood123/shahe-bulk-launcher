<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ShaheLauncher.App</RootNamespace>
    <AssemblyName>沙河批量打开器</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ShaheLauncher.Core\ShaheLauncher.Core.csproj" />
    <ProjectReference Include="..\ShaheLauncher.Updater\ShaheLauncher.Updater.csproj" ReferenceOutputAssembly="false" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <None Update="lib\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <Target Name="CopyUpdater" AfterTargets="Build">
    <Copy
      SourceFiles="$(MSBuildThisFileDirectory)..\ShaheLauncher.Updater\bin\$(Platform)\$(Configuration)\net48\updater.exe"
      DestinationFolder="$(OutDir)"
      SkipUnchangedFiles="true"
      Condition="'$(BaseOutputPath)' == 'bin\' and Exists('$(MSBuildThisFileDirectory)..\ShaheLauncher.Updater\bin\$(Platform)\$(Configuration)\net48\updater.exe')" />
  </Target>
</Project>
