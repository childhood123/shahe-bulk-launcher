<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ShaheLauncher.App</RootNamespace>
    <AssemblyName>沙河批量打开器</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ShaheLauncher.Core\ShaheLauncher.Core.csproj" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\打赏\*.jpg" Link="打赏\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="lib\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <Target Name="PrepareUpdatePublish" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)Configurations" />
    <Copy SourceFiles="$(PublishDir)$(TargetFileName)" DestinationFiles="$(PublishDir)updater.exe"
      Condition="'$(IncludeLegacyUpdateCompatibility)' == 'true'" />
    <Copy SourceFiles="$(PublishDir)$(TargetFileName).config" DestinationFiles="$(PublishDir)updater.exe.config"
      Condition="'$(IncludeLegacyUpdateCompatibility)' == 'true' and Exists('$(PublishDir)$(TargetFileName).config')" />
  </Target>
</Project>
